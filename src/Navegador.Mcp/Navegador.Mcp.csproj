<Project Sdk="Microsoft.NET.Sdk">

  <!-- Servidor MCP opcional (fase 6.3): un LLM maneja el navegador a través de la API local pública. El navegador no lo
       necesita para nada. Sin dependencias: sólo .NET. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>navegador-mcp</AssemblyName>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
