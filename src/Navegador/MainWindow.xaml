<Window x:Class="Navegador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navegador" Width="1280" Height="820" MinWidth="480" MinHeight="320"
        Background="#202124" Foreground="#E8EAED" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3C4043"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5F6368"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#BDC1C6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3C4043"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pestañas -->
        <DockPanel x:Name="TabBar" Grid.Row="0" Background="#202124" Margin="6,6,6,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Nueva pestaña (Ctrl+T)" Click="NewTab_Click" VerticalAlignment="Center"/>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScroll_Wheel">
                <ItemsControl x:Name="TabList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="tab" Width="200" Height="34" Margin="0,0,2,0" CornerRadius="8,8,0,0" Padding="10,0,4,0"
                                    Background="Transparent" Cursor="Hand" ToolTip="{Binding Title}"
                                    MouseLeftButtonDown="Tab_MouseDown" MouseUp="Tab_MouseUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Source="{Binding FaviconUri, TargetNullValue={x:Null}}"/>
                                    <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Foreground="#BDC1C6"/>
                                    <TextBlock Grid.Column="2" Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="4,0"
                                               VerticalAlignment="Center" Foreground="#8AB4F8" ToolTip="Dormida: no usa CPU y casi nada de RAM">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                            Width="22" Height="22" Click="CloseTab_Click" ToolTip="Cerrar (Ctrl+W)"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="tab" Property="Background" Value="#35363A"/>
                                    <Setter TargetName="title" Property="Foreground" Value="#E8EAED"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                    <Setter TargetName="title" Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Barra de herramientas -->
        <Grid x:Name="Toolbar" Grid.Row="1" Background="#35363A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Atrás (Alt+←)" Click="Back_Click"/>
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Adelante (Alt+→)" Click="Forward_Click"/>
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Recargar (F5)" Click="Reload_Click"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#202124" CornerRadius="15" Margin="4,5" Padding="12,0">
                <TextBox x:Name="Address" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" CaretBrush="#E8EAED"
                         VerticalContentAlignment="Center" Height="30" FontSize="14"
                         KeyDown="Address_KeyDown" GotKeyboardFocus="Address_GotFocus" PreviewMouseLeftButtonDown="Address_PreviewMouseDown"/>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,4,8,4">
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Ajustes (settings.json; se aplican al reiniciar)" Click="Settings_Click"/>
            </StackPanel>
        </Grid>

        <!-- Contenido: un WebView2 por pestaña viva; sólo el activo es visible -->
        <Grid x:Name="Host" Grid.Row="2" Background="White">
            <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5F6368" FontSize="16" Visibility="Collapsed"/>
        </Grid>

        <!-- Estado: lo que hace liviano al navegador, a la vista -->
        <DockPanel x:Name="StatusBar" Grid.Row="3" Background="#202124" LastChildFill="False">
            <TextBlock x:Name="MemoryText" DockPanel.Dock="Left" Margin="10,3" Foreground="#9AA0A6" VerticalAlignment="Center"/>
            <TextBlock x:Name="HintText" DockPanel.Dock="Left" Margin="10,3" Foreground="Orange" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            <Button x:Name="ShieldButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="4,1" Click="Shield_Click"
                    ToolTip="Clic: permitir o volver a bloquear en este sitio">
                <TextBlock x:Name="ShieldText"/>
            </Button>
        </DockPanel>
    </Grid>
</Window>
