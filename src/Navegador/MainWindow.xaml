<Window x:Class="Navegador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Astro" Width="1280" Height="820" MinWidth="480" MinHeight="320"
        Background="#202124" Foreground="#E8EAED" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#35363A"/>

        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#292A2D" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="#3C4043"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3C4043"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5F6368"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#BDC1C6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3C4043"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pestañas -->
        <DockPanel x:Name="TabBar" Grid.Row="0" Background="#202124" Margin="6,6,6,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Nueva pestaña (Ctrl+T)" Click="NewTab_Click" VerticalAlignment="Center"/>
            <TextBlock x:Name="PrivateBadge" DockPanel.Dock="Left" Text="Privada" Foreground="#C58AF9" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="6,0,10,0" Visibility="Collapsed"/>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScroll_Wheel">
                <ItemsControl x:Name="TabList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="tab" Width="200" Height="34" Margin="0,0,2,0" CornerRadius="8,8,0,0" Padding="10,0,4,0"
                                    Background="Transparent" Cursor="Hand" ToolTip="{Binding Title}"
                                    MouseLeftButtonDown="Tab_MouseDown" MouseUp="Tab_MouseUp">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Recargar" Click="TabMenu_Reload"/>
                                        <MenuItem Header="Duplicar" Click="TabMenu_Duplicate"/>
                                        <MenuItem Header="Dormir ahora" Click="TabMenu_Sleep" IsEnabled="{Binding CanSleep}"/>
                                        <Separator/>
                                        <MenuItem Header="Cerrar las demás pestañas" Click="TabMenu_CloseOthers"/>
                                        <MenuItem Header="Cerrar" InputGestureText="Ctrl+W" Click="TabMenu_Close"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Source="{Binding FaviconUri, TargetNullValue={x:Null}}"/>
                                    <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Foreground="#BDC1C6"/>
                                    <TextBlock Grid.Column="2" Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="4,0"
                                               VerticalAlignment="Center" Foreground="#8AB4F8" ToolTip="Dormida: no usa CPU y casi nada de RAM">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                            Width="22" Height="22" Click="CloseTab_Click" ToolTip="Cerrar (Ctrl+W)"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="tab" Property="Background" Value="{DynamicResource ToolbarBrush}"/>
                                    <Setter TargetName="title" Property="Foreground" Value="#E8EAED"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                    <Setter TargetName="title" Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Barra de herramientas -->
        <Grid x:Name="Toolbar" Grid.Row="1" Background="{DynamicResource ToolbarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Atrás (Alt+←)" Click="Back_Click"/>
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Adelante (Alt+→)" Click="Forward_Click"/>
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Recargar (F5)" Click="Reload_Click"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#202124" CornerRadius="15" Margin="4,5" Padding="12,0,2,0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="StarButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE734;"
                            Width="28" Height="28" ToolTip="Agregar a favoritos (Ctrl+D)" Click="Star_Click"/>
                    <TextBlock x:Name="LockIcon" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9AA0A6"/>
                    <TextBox x:Name="Address" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" CaretBrush="#E8EAED"
                             VerticalContentAlignment="Center" Height="30" FontSize="14"
                             KeyDown="Address_KeyDown" GotKeyboardFocus="Address_GotFocus" PreviewMouseLeftButtonDown="Address_PreviewMouseDown"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,4,8,4">
                <Button x:Name="MeetingButton" Style="{StaticResource IconButton}" Content="&#xE720;" Click="Meeting_Click"/>
                <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Menú" Click="Menu_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
        <!-- Permiso para una app local que pide usar la API (fase 6.2) -->
        <Border x:Name="ApprovalBar" Background="#1E3A5F" Padding="12,6" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="ApprovalDeny_Click">
                    <TextBlock Text="Rechazar" Foreground="#E8EAED"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Background="#8AB4F8" Margin="12,0,0,0" Click="ApprovalAllow_Click">
                    <TextBlock Text="Permitir" Foreground="#202124" FontWeight="SemiBold"/>
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="&#xE71B;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#8AB4F8"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="ApprovalText" Foreground="#E8EAED" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Buscar en la página -->
        <Border x:Name="FindBar" Background="{DynamicResource ToolbarBrush}" Padding="8,0,8,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Background="#202124" CornerRadius="12" Padding="10,0" Width="260">
                    <TextBox x:Name="FindBox" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" CaretBrush="#E8EAED"
                             Height="26" VerticalContentAlignment="Center" TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
                </Border>
                <TextBlock x:Name="FindCount" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="10,0" MinWidth="50"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Anterior (Shift+Enter)" Click="FindPrev_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Siguiente (Enter)" Click="FindNext_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Cerrar (Esc)" Click="FindClose_Click"/>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Contenido: un WebView2 por pestaña viva; sólo el activo es visible -->
        <Grid x:Name="Host" Grid.Row="3" Background="White">
            <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5F6368" FontSize="16" Visibility="Collapsed"/>
            <!-- Snapshot: foto de la pestaña dormida mientras despierta -->
            <Grid x:Name="SnapshotOverlay" Visibility="Collapsed">
                <Image x:Name="SnapshotImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Background="#CC202124"
                        CornerRadius="12" Padding="12,4">
                    <TextBlock Text="Despertando…" Foreground="#E8EAED" FontSize="12"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Estado: lo que hace liviano al navegador, a la vista -->
        <DockPanel x:Name="StatusBar" Grid.Row="4" Background="#202124" LastChildFill="False">
            <TextBlock x:Name="MemoryText" DockPanel.Dock="Left" Margin="10,3" Foreground="#9AA0A6" VerticalAlignment="Center"/>
            <TextBlock x:Name="MeetingText" DockPanel.Dock="Left" Margin="10,3" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            <TextBlock x:Name="HintText" DockPanel.Dock="Left" Margin="10,3" Foreground="Orange" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            <Button x:Name="ShieldButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="4,1" Click="Shield_Click"
                    ToolTip="Clic: permitir o volver a bloquear en este sitio">
                <TextBlock x:Name="ShieldText"/>
            </Button>
            <Button x:Name="ZoomButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="4,1" Click="ZoomReset_Click"
                    ToolTip="Zoom de esta pestaña. Clic: volver a 100 %" Visibility="Collapsed">
                <TextBlock x:Name="ZoomText"/>
            </Button>
        </DockPanel>
    </Grid>
</Window>
