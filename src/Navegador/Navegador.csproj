<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.6.0</Version>
    <!-- Nombre visible: Astro (lo que muestran Windows y el instalador). El ejecutable, los espacios de nombres y la
         carpeta de datos siguen llamándose Navegador. -->
    <Product>Astro</Product>
    <AssemblyTitle>Astro</AssemblyTitle>
    <ApplicationIcon>navegador.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Navegador.Core\Navegador.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <None Update="blocklist.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Meeting/virtual-mic.js" LogicalName="virtual-mic.js" />
    <Resource Include="navegador.ico" />
  </ItemGroup>

  <!-- El traductor de voz (src/Astro.Voz → astro-voz.exe) es un programa aparte que viaja en la subcarpeta voz\, con
       sus propias bibliotecas. Se compila y se copia junto con Astro, al compilar y al publicar. -->
  <ItemGroup>
    <!-- Sólo para que se restaure y compile antes: Astro no usa su código, lo lanza como proceso. -->
    <ProjectReference Include="..\Astro.Voz\Astro.Voz.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="VozAlCompilar" AfterTargets="Build">
    <MSBuild Projects="..\Astro.Voz\Astro.Voz.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(MSBuildProjectDirectory)\$(OutDir)voz\" />
  </Target>
  <Target Name="VozAlPublicar" AfterTargets="Publish">
    <MSBuild Projects="..\Astro.Voz\Astro.Voz.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)voz\" />
  </Target>
</Project>
